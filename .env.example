# ==============================================================================
# FLUXO TAREFAS API - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env antes de iniciar os contêineres:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# DJANGO CORE
# ------------------------------------------------------------------------------
# Chave secreta da aplicação (altere obrigatoriamente em produção)
SECRET_KEY=django-insecure-change-me-in-production-random-key-secret-1234567890

# Modo de depuração (True em desenvolvimento, False em produção)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Módulo de configurações ativo (config.settings.dev ou config.settings.production)
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# ------------------------------------------------------------------------------
# URL de conexão no formato dj-database-url consumida pelo Django
DATABASE_URL=postgres://postgres:postgrespassword@db:5432/fluxo_tarefas_db

# Parâmetros de inicialização do contêiner db no Docker Compose
POSTGRES_DB=fluxo_tarefas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# REDIS & CELERY (Broker & Result Backend)
# ------------------------------------------------------------------------------
# URL do Redis para filas assíncronas do Celery e cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# CORS & SEGURANÇA
# ------------------------------------------------------------------------------
# Permite requisições de todas as origens (recomendado True apenas em dev)
CORS_ALLOW_ALL_ORIGINS=True

# Origens autorizadas em produção (separadas por vírgula)
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://api.exemplo.com
